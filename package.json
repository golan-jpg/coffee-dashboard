{
  "name": "coffee-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:full",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:api": "node server/backup-user-ratings.js",
    "dev:full": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:full:lan": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:lan\"",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173",
    "import:lists": "node scripts/import-google-lists.mjs",
    "import:ect": "node scripts/import-european-coffee-trip.mjs",
    "import:ect:write": "node scripts/import-european-coffee-trip.mjs --write",
    "import:ect:all": "node scripts/import-all-ect-cities.mjs",
    "discover:specialty": "node scripts/discover-specialty-places.mjs",
    "discover:specialty:write": "node scripts/discover-specialty-places.mjs --write",
    "geocode:seeded": "node scripts/geocode-seeded-places.mjs",
    "geocode:seeded:write": "node scripts/geocode-seeded-places.mjs --write",
    "audit:missing-addresses": "node scripts/audit-missing-addresses.mjs",
    "fill:missing-addresses": "node scripts/fill-missing-addresses-from-coords.mjs",
    "recover:legacy-ratings": "node scripts/recover-legacy-indexed-ratings.mjs",
    "recover:legacy-ratings:auto": "node scripts/recover-legacy-indexed-ratings.mjs --auto --write"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "node-fetch": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5"
  }
}
